{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automerge: grouped patch PRs merge once the required commit and integration checks pass (ruleset). Minor and major updates are reviewed by hand.",
  "extends": [
    "local>bbaliyan/renovate-config",
    ":gitSignOff"
  ],
  "enabledManagers": [
    "terraform",
    "github-actions",
    "ansible-galaxy",
    "pip_requirements"
  ],
  "packageRules": [
    {
      "description": "Ignore .terraform/ lockfile paths",
      "matchFileNames": [
        "**/.terraform/**"
      ],
      "enabled": false
    }
  ]
}
