{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["renovate"],
  "enabledManagers": ["terraform", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "K3s version — single source of truth in modules/component-versions/main.tf, coalesced as the default fallback by every control-plane/node-pool module and cloud-init",
      "fileMatch": ["^modules/component-versions/main\\.tf$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+k8s_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Helm chart versions (Cilium, Argo CD) — single source of truth in modules/component-versions/main.tf, coalesced as the default fallback by cloud-init. Both use plain semver, so one manager covers both.",
      "fileMatch": ["^modules/component-versions/main\\.tf$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) registryUrl=(?<registryUrl>.*?)\\s+cilium_version\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) registryUrl=(?<registryUrl>.*?)\\s+argocd_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "kube-vip image tag pinned in proxmox-control-plane's HA DaemonSet manifest",
      "fileMatch": ["^modules/proxmox-control-plane/main\\.tf$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+image:\\s*ghcr\\.io/kube-vip/kube-vip:(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Batch routine patch updates into one weekly PR",
      "matchUpdateTypes": ["patch", "pin", "pinDigest"],
      "groupName": "patch updates",
      "schedule": ["before 6am on Monday"]
    },
    {
      "description": "Auto-merge patch PRs once CI is green",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Minor/major require manual review",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["renovate", "needs-review"]
    },
    {
      "description": "Security fixes get individual PRs immediately",
      "matchCategories": ["security"],
      "groupName": null,
      "schedule": ["at any time"],
      "automerge": false,
      "labels": ["renovate", "security"]
    },
    {
      "description": "Ignore .terraform/ lockfile paths",
      "matchFileNames": ["**/.terraform/**"],
      "enabled": false
    }
  ]
}
