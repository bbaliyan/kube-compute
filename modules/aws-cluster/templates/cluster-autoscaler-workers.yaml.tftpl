# SPDX-License-Identifier: Apache-2.0
# Cluster + AWSCluster, then an AWSMachineTemplate and MachineDeployment per
# worker group. A group is the unit cluster-autoscaler scales, so anything a pod
# can select on -- architecture, a taint, a shape -- is a separate group.
#
# No bootstrap-provider CRD: each group's Machine.spec.bootstrap.dataSecretName
# points at a Secret carrying the same cloud-init node-bootstrap renders for every
# other worker here. That Secret is NOT in this file: it is one per group and the
# largest thing in the bundle, and the control plane's user data, where this file
# travels, is capped at 25600 bytes by EC2. The genesis node fetches each one from
# SSM at boot instead -- see aws_ssm_parameter.autoscaler_worker_bootstrap -- so a
# MachineDeployment here references a Secret that arrives beside it. CAPRKE2 is deliberately unused, for the
# reason recorded on the Proxmox template -- its worker-join path requires a live
# CAPRKE2-owned RKE2ControlPlane object, and this control plane belongs to
# Terraform.
#
# Cluster.spec.controlPlaneRef is omitted. Cluster.spec.infrastructureRef points
# at a real AWSCluster, because CAPA's AWSMachine reconciler does a hard Get on
# it; the cluster.x-k8s.io/managed-by annotation is what stops CAPA reconciling
# that object's own fields, so it exists to satisfy the Get rather than to let
# CAPA own network fabric Terraform already created.
#
# UNVERIFIED, in the order to check if no worker instance ever appears:
#
# 1. Readiness, not existence. The managed-by annotation stops CAPA's AWSCluster
#    controller reconciling this object, so nothing ever sets status.ready or
#    Cluster.status.infrastructureReady -- and CAPI's Machine controller gates
#    machine creation on the latter. CAPI's externally-managed contract says the
#    external controller is responsible for setting it, and nothing in this
#    project does. Same open question the Proxmox template records, unresolved
#    there too. If machines never appear and the AWSMachine shows no error, patch
#    AWSCluster.status.ready = true and see whether provisioning starts.
# 2. Required AWSClusterSpec fields beyond what is set here. The Proxmox
#    equivalent needed two real applies to find spec.dnsServers and
#    spec.ipv4Config. CRD admission will name anything else it wants.
# 3. iamInstanceProfile must be a profile NAME, not an ARN, and must already
#    exist -- CAPA creates none when the cluster is externally managed.
# 4. IAM on the CONTROLLER, not the machine. CAPA authenticates through the
#    control-plane node's instance profile, so that role needs RunInstances,
#    TerminateInstances, Describe*, CreateTags and PassRole for the worker
#    profile. The consumer repo attaches that policy.
apiVersion: cluster.x-k8s.io/v1beta1
kind: Cluster
metadata:
  name: ${cluster_name}
  namespace: default
spec:
  infrastructureRef:
    apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
    kind: AWSCluster
    name: ${cluster_name}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: ${cluster_name}
  namespace: default
  annotations:
    cluster.x-k8s.io/managed-by: ""
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
spec:
  region: ${aws_region}
  # Empty, because this project has no inbound SSH anywhere -- SSM is the only
  # operator access path. CAPA treats an omitted key as "use the account default",
  # which would silently attach one.
  sshKeyName: ""
  bastion:
    enabled: false
  # Pre-existing fabric. CAPA must adopt it, never create it: the VPC and subnets
  # belong to the account, not to this cluster.
  network:
    vpc:
      id: ${vpc_id}
    subnets:
      - id: ${subnet_id}
  controlPlaneEndpoint:
    host: ${control_plane_endpoint_host}
    port: ${control_plane_endpoint_port}
%{ for name, g in worker_groups ~}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: ${cluster_name}-${name}
  namespace: default
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
spec:
  template:
    spec:
      instanceType: ${g.instance_type}
      ami:
        id: ${g.ami_id}
      iamInstanceProfile: ${iam_instance_profile}
      subnet:
        id: ${subnet_id}
      additionalSecurityGroups:
%{ for sg in g.security_group_ids ~}
        - id: ${sg}
%{ endfor ~}
      publicIP: false
      sshKeyName: ""
      rootVolume:
        size: ${g.root_volume_size_gb}
        type: ${g.root_volume_type}
        encrypted: true
      # hop_limit 3, not AWS's documented 2: IMDSv2 caps the token response's TTL
      # to it, and Cilium's pod-netns routing costs 2 hops. Confirmed live on this
      # project's own nodes.
      instanceMetadataOptions:
        httpEndpoint: enabled
        httpTokens: required
        httpPutResponseHopLimit: 3
      additionalTags:
        ClusterName: ${cluster_name}
        NodeGroup: ${name}
        ManagedBy: kube-compute
---
apiVersion: cluster.x-k8s.io/v1beta1
kind: MachineDeployment
metadata:
  name: ${cluster_name}-${name}
  namespace: default
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
  annotations:
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-min-size: "${g.min_size}"
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-max-size: "${g.max_size}"
    # Read only while the group has no nodes. Without them cluster-autoscaler
    # cannot tell whether a Pending pod would fit here, so it never scales the
    # group off zero -- and a group whose nodes carry a taint is exactly the case
    # that starts at zero.
    capacity.cluster-autoscaler.kubernetes.io/cpu: "${g.cpu}"
    capacity.cluster-autoscaler.kubernetes.io/memory: "${g.memory_mib}Mi"
%{ if length(g.labels) > 0 ~}
    capacity.cluster-autoscaler.kubernetes.io/labels: "${join(",", [for k, v in g.labels : "${k}=${v}"])}"
%{ endif ~}
%{ if length(g.taints) > 0 ~}
    capacity.cluster-autoscaler.kubernetes.io/taints: "${join(",", g.taints)}"
%{ endif ~}
spec:
  clusterName: ${cluster_name}
  replicas: ${g.min_size}
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: ${cluster_name}
      kube-compute.io/node-group: ${name}
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: ${cluster_name}
        kube-compute.io/node-group: ${name}
    spec:
      clusterName: ${cluster_name}
      bootstrap:
        dataSecretName: ${cluster_name}-${name}-bootstrap
      infrastructureRef:
        apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
        kind: AWSMachineTemplate
        name: ${cluster_name}-${name}
%{ endfor ~}
