# SPDX-License-Identifier: Apache-2.0
# Cluster + Secret + ProxmoxMachineTemplate + MachineDeployment for
# CAPI/CAPMOX-managed autoscaler workers. No bootstrap-provider CRD at all:
# the Secret carries the exact same cloud-init this project's node-bootstrap
# already renders for proxmox-node-pool's own workers (rendered by the
# sibling module.cluster_autoscaler_worker_bootstrap instantiation in
# ../main.tf), referenced via Machine.spec.bootstrap.dataSecretName —
# CAPRKE2 and its RKE2ConfigTemplate are deliberately not used here (see
# kube-claude's 2026-08-09-cluster-autoscaler-proxmox-capi.md plan's revision
# note for why: CAPRKE2's worker-join path hard-requires a live,
# CAPRKE2-owned RKE2ControlPlane object, incompatible with this project's
# Terraform-owned control plane).
#
# Cluster.spec.controlPlaneRef is omitted — confirmed safe (cluster-adoption.md
# §1, §5.4). Cluster.spec.infrastructureRef, however, points at a real
# ProxmoxCluster object below: a kube-image Task 1 spike read CAPMOX's actual
# source (ProxmoxMachineReconciler.getInfraCluster, ionos-cloud/
# cluster-api-provider-proxmox) and confirmed a hard client.Get() for
# ProxmoxCluster keyed on Cluster.spec.infrastructureRef.Name, with NO
# nil-tolerant fallback — an omitted infrastructureRef resolves to an empty
# name, the Get fails, and ProxmoxMachineReconciler silently no-ops forever
# ("ProxmoxCluster is not ready yet", no error, no VM ever created). The
# managed-by annotation below (confirmed real and implemented by CAPMOX's own
# controller via predicates.ResourceIsNotExternallyManaged — cluster-adoption.md
# §3) stops CAPMOX from trying to reconcile/own this object's own fields, so it
# exists purely to satisfy the Get(), not to let CAPMOX manage cluster-level
# Proxmox infrastructure Terraform already owns.
#
# UNVERIFIED (check these first if no worker VM ever appears, in this order):
# 1. Readiness, not just existence: the managed-by annotation stops CAPMOX's
#    ProxmoxCluster controller from reconciling this object at all — nothing
#    ever sets its status.ready. If ProxmoxMachineReconciler's own quoted log
#    line ("ProxmoxCluster is not ready yet") means it gates on readiness
#    AFTER the Get() succeeds, satisfying the Get() alone doesn't fully fix
#    the silent-no-op problem this object exists to solve — it would just
#    move the no-op from "object missing" to "object never ready". Not
#    checked in either research pass; this project has no mechanism today
#    that would ever patch that status field.
# 2. (RESOLVED on a real apply, CAPMOX v0.9.0): ProxmoxClusterSpec DOES have
#    other required fields beyond what a prior revision of this template
#    set — spec.dnsServers, and spec.ipv4Config (or ipv6Config). An empty
#    `spec: {}` is rejected outright by CRD admission ("spec.dnsServers:
#    Required value", then separately "at least one ip config must be set,
#    either ipv4Config or ipv6Config"). dnsServers is filled from this
#    project's existing dns_servers input. ipv4Config is CAPMOX's own static
#    IPAM — confirmed via `kubectl explain proxmoxcluster.spec.ipv4Config`
#    against the live CRD that CAPMOX has no DHCP mode for CAPI-managed
#    Machines (ProxmoxMachine's network.default has only an optional
#    ipv4PoolRef, no dhcp toggle) — filled from
#    cluster_autoscaler_worker_ip_pool, a caller-supplied static range
#    excluded from the LAN's DHCP pool.
# 3. (RESOLVED on a real apply): spec.controlPlaneEndpoint.host also rejects
#    empty ("provided endpoint address is not a valid IP or FQDN"), despite
#    not being marked -required- by `kubectl explain`. This ProxmoxCluster
#    never actually drives anything off this value (no controlPlaneRef —
#    see above), so it's filled with the same genesis self-registered DNS
#    name autoscaler workers already join through (main.tf's
#    cluster_autoscaler_registration_address), not
#    module.control_plane.cluster_ip/cluster_fqdn (would cycle).
apiVersion: cluster.x-k8s.io/v1beta1
kind: Cluster
metadata:
  name: ${cluster_name}
  namespace: default
spec:
  infrastructureRef:
    apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
    kind: ProxmoxCluster
    name: ${cluster_name}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: ProxmoxCluster
metadata:
  name: ${cluster_name}
  namespace: default
  annotations:
    cluster.x-k8s.io/managed-by: ""
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
spec:
  dnsServers:
%{ for server in dns_servers ~}
    - ${server}
%{ endfor ~}
  ipv4Config:
    addresses:
%{ for address in ip_pool_addresses ~}
      - ${address}
%{ endfor ~}
    gateway: ${ip_pool_gateway}
    prefix: ${ip_pool_prefix}
    metric: ${ip_pool_metric}
  controlPlaneEndpoint:
    host: ${control_plane_endpoint_host}
    port: ${control_plane_endpoint_port}
---
apiVersion: v1
kind: Secret
metadata:
  name: ${cluster_name}-autoscaler-worker-bootstrap
  namespace: default
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
type: Opaque
data:
  value: ${bootstrap_secret_b64}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: ProxmoxMachineTemplate
metadata:
  name: ${cluster_name}-autoscaler-workers
  namespace: default
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
spec:
  template:
    spec:
      numCores: ${vm_cores}
      memoryMiB: ${vm_memory_mib}
      disks:
        bootVolume:
          disk: scsi0
          sizeGb: ${vm_disk_gb}
      sourceNode: ${proxmox_node}
      templateID: ${proxmox_template_vm_id}
      storage: ${disk_datastore_id}
      network:
        default:
          bridge: ${network_bridge}
---
apiVersion: cluster.x-k8s.io/v1beta1
kind: MachineDeployment
metadata:
  name: ${cluster_name}-autoscaler-workers
  namespace: default
  labels:
    cluster.x-k8s.io/cluster-name: ${cluster_name}
  annotations:
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-min-size: "${min_size}"
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-max-size: "${max_size}"
spec:
  clusterName: ${cluster_name}
  replicas: ${min_size}
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: ${cluster_name}
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: ${cluster_name}
    spec:
      clusterName: ${cluster_name}
      bootstrap:
        dataSecretName: ${cluster_name}-autoscaler-worker-bootstrap
      infrastructureRef:
        apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
        kind: ProxmoxMachineTemplate
        name: ${cluster_name}-autoscaler-workers
