#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# kube-compute: this node's boot payload does not fit in EC2 user data (16384
# bytes decoded), so user data is a pointer to it. The payload lives in SSM, in
# pieces, readable only by this instance's own role.
#
# payload-sha256: ${payload_sha}
#
# That hash is not decoration: it is what makes a changed payload a changed user
# data, so user_data_replace_on_change still replaces the instance. Without it an
# apply would leave a node running yesterday's configuration with a clean plan.
set -euo pipefail
exec > >(tee -a /var/log/kube-compute-payload.log) 2>&1
echo "kube-compute: fetching boot payload $(date -Is)"

# Same first act as the inline path: SSM Agent is this project's only operator
# access route, and it is also how anyone debugs the fetch below failing.
systemctl enable --now amazon-ssm-agent 2>/dev/null || true

D=/var/lib/kube-compute
install -d -m 0700 "$D"

fetch() {
  local name="$1" dest="$2" attempt
  for attempt in 1 2 3 4 5; do
    if aws ssm get-parameter --name "$name" --with-decryption --region ${aws_region} \
      --query Parameter.Value --output text >"$dest"; then
      return 0
    fi
    sleep 5
  done
  echo "kube-compute: could not read $name after 5 attempts -- this instance's role must allow ssm:GetParameter on /kube-compute/${cluster_name}/node-payload/*, and the parameter must exist" >&2
  return 1
}

%{ for i, name in parameter_names ~}
install -m 0600 /dev/null "$D/payload.${i + 1}"
fetch "${name}" "$D/payload.${i + 1}"
%{ endfor ~}
# gzip's CRC is the integrity check on something that arrived in pieces: a missing
# or stale piece fails here rather than half-configuring a node.
install -m 0700 /dev/null "$D/setup.sh"
if ! cat %{ for i, name in parameter_names ~}"$D/payload.${i + 1}" %{ endfor ~}| base64 -d | gzip -dc >"$D/setup.sh"; then
  echo "kube-compute: the payload did not decode -- its pieces are incomplete or do not belong together" >&2
  exit 1
fi
rm -f "$D"/payload.[0-9]*

echo "kube-compute: payload ok, $(wc -c <"$D/setup.sh") bytes"
exec "$D/setup.sh"
