{# SPDX-License-Identifier: Apache-2.0 #}
{% if node_role == 'worker' %}
server: https://{{ registration_address }}:9345
token: {{ resolved_agent_token }}
node-ip: {{ ansible_default_ipv4.address }}
{% if node_labels %}
node-label:
{% for label_key, label_val in node_labels.items() %}
  - "{{ label_key }}={{ label_val }}"
{% endfor %}
{% endif %}
{% else %}
{% if server_line %}
{{ server_line }}
{% endif %}
token: {{ resolved_cluster_token }}
agent-token: {{ resolved_cluster_agent_token }}
node-ip: {{ ansible_default_ipv4.address }}
tls-san:
  - {{ ansible_default_ipv4.address }}
{% if cluster_fqdn %}
  - {{ cluster_fqdn }}
{% endif %}
{% for san in extra_tls_sans %}
  - {{ san }}
{% endfor %}
write-kubeconfig-mode: "0644"
secrets-encryption: true
disable-cloud-controller: true
{# Disables whatever RKE2's default ingress controller is for the installed
   version (ingress-nginx or Traefik) — this project doesn't bundle one at
   bootstrap, mirroring cloud-init's --disable traefik precedent. #}
ingress-controller: none
{% if control_plane_taint %}
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"
{% endif %}
{% if cni == 'cilium' %}
cni: cilium
disable-kube-proxy: true
{% endif %}
{% if etcd_snapshot_enabled %}
etcd-snapshot-schedule-cron: '{{ etcd_snapshot_schedule_cron }}'
etcd-snapshot-retention: {{ etcd_snapshot_retention }}
{% if etcd_snapshot_object_store_bucket %}
etcd-s3: true
etcd-s3-bucket: {{ etcd_snapshot_object_store_bucket }}
{% if etcd_snapshot_object_store_region %}
etcd-s3-region: {{ etcd_snapshot_object_store_region }}
{% endif %}
{% if etcd_snapshot_object_store_endpoint %}
etcd-s3-endpoint: {{ etcd_snapshot_object_store_endpoint }}
{% endif %}
{% if etcd_snapshot_object_store_folder %}
etcd-s3-folder: {{ etcd_snapshot_object_store_folder }}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
