{# Deliberately independent of platform-app.yaml.j2: no shared app-of-apps parent,
   no sync-wave ordering against it. Eventual consistency — if a workload needs
   something platform provides, Argo CD's own automated selfHeal/retry converges
   it once platform catches up, same as everywhere else in this project. #}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: workloads
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ gitops_workloads_repo_url }}
    targetRevision: {{ gitops_workloads_revision }}
    path: {{ gitops_workloads_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: ["CreateNamespace=true"]
