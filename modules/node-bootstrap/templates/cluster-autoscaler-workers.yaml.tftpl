# SPDX-License-Identifier: Apache-2.0
# MachineDeployment + ProxmoxMachineTemplate + RKE2ConfigTemplate for
# CAPI/CAPMOX/CAPRKE2-managed autoscaler workers. Field names and paths come
# directly from the research spike's field-mapping table
# (.scratch/cluster-autoscaler-worker-provisioning/research/implementation-unknowns.md
# §3 in kube-claude), not invented here.
#
# Spike finding (plan Task 3 Step 1): this environment has no kubectl/
# clusterctl/live-cluster access to confirm RKE2AgentConfig.nodeLabels's
# string format or whether CAPMOX has an ssh_authorized_keys field (vs. going
# through CAPRKE2's RKE2ConfigSpec.files). Both remain UNRESOLVED. Per the
# plan's documented fallback, agentConfig.nodeLabels and any
# ssh_authorized_keys/files handling are deliberately omitted below rather
# than guessed at — a wrong guess would violate this project's "no
# placeholders" discipline more than leaving the fields out until a real
# CRD/cluster confirms their shape.
apiVersion: cluster.x-k8s.io/v1beta1
kind: MachineDeployment
metadata:
  name: ${cluster_name}-autoscaler-workers
  namespace: default
  annotations:
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-min-size: "${min_size}"
    cluster.x-k8s.io/cluster-api-autoscaler-node-group-max-size: "${max_size}"
spec:
  clusterName: ${cluster_name}
  replicas: ${min_size}
  selector:
    matchLabels: {}
  template:
    spec:
      clusterName: ${cluster_name}
      bootstrap:
        configRef:
          apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
          kind: RKE2ConfigTemplate
          name: ${cluster_name}-autoscaler-workers
      infrastructureRef:
        apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
        kind: ProxmoxMachineTemplate
        name: ${cluster_name}-autoscaler-workers
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: ProxmoxMachineTemplate
metadata:
  name: ${cluster_name}-autoscaler-workers
  namespace: default
spec:
  template:
    spec:
      numCores: ${vm_cores}
      memoryMiB: ${vm_memory_mib}
      disks:
        bootVolume:
          disk: scsi0
          sizeGb: ${vm_disk_gb}
      sourceNode: ${proxmox_node}
      templateID: ${proxmox_template_vm_id}
      storage: ${disk_datastore_id}
      network:
        default:
          bridge: ${network_bridge}
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
kind: RKE2ConfigTemplate
metadata:
  name: ${cluster_name}-autoscaler-workers
  namespace: default
spec:
  template:
    spec:
      agentConfig:
        airGapped: true
        version: ${k8s_version}
