output "cluster_name" {
  description = "Cluster name passed to the module."
  value       = var.cluster_name
}

output "instance_id" {
  description = "Provider-native node ID of the genesis control-plane VM."
  value       = tostring(proxmox_virtual_environment_vm.control_plane["0"].vm_id)
}

output "cluster_ip" {
  description = "Genesis control-plane node's IP. For control_plane_count > 1, prefer cluster_fqdn (when dns_registration_enabled) for a name that covers every control-plane node, not just genesis."
  value       = local.cp_ips["0"]
}

output "cluster_fqdn" {
  description = "API server FQDN for kubectl, or null when no cluster_domain was given. It is always computed from cluster_domain, so check dns_registration_enabled before you use it. Do not use it as the registration_address of proxmox-node-pool."
  value       = local.cluster_fqdn
}

output "dns_registration_enabled" {
  description = "Whether this control plane published cluster_fqdn to a DNS server through dns-registration (true only when dns_server_address is set). Check it before you connect through cluster_fqdn. Worker joins do not use it."
  value       = local.dns_registration_enabled
}

output "node_provider" {
  description = "Provider identifier ('proxmox'). Control-plane scripts dispatch via qm guest exec for this provider."
  value       = "proxmox"
}

output "node_control_ref" {
  description = "Genesis VM ID, for control-plane verb-scripts that need a single node reference."
  value       = tostring(proxmox_virtual_environment_vm.control_plane["0"].vm_id)
}

output "wildcard_dns_name" {
  description = "Wildcard hostname for cluster services, or null when no cluster_domain was given. The control plane publishes it only on an all_in_one cluster with dns_server_address set and manage_wildcard_dns_record on; see wildcard_registration_enabled."
  value       = local.wildcard_name
}

output "wildcard_registration_enabled" {
  description = "Whether this control plane published wildcard_dns_name itself. See wildcard_dns_name."
  value       = local.wildcard_registration_enabled
}

output "proxmox_node" {
  description = "Proxmox node every control-plane VM runs on."
  value       = var.proxmox_node
}

output "cluster_token" {
  description = "Shared secret used to join a server to the cluster (rke2 config.yaml's token:), generated by this module. Not consumed by proxmox-node-pool — workers only ever need the agent token below."
  value       = random_password.server_token.result
  sensitive   = true
}

output "cluster_agent_token" {
  description = "Separate shared secret accepted only from agents (config.yaml agent-token), generated by this module. Pass it to the cluster_agent_token input of proxmox-node-pool at the consumer layer. The two modules do not depend on each other."
  value       = random_password.agent_token.result
  sensitive   = true
}

output "control_plane_node_refs" {
  description = "Map of control-plane node name -> {instance_id, ip, provider}."
  value = {
    for k, vm in proxmox_virtual_environment_vm.control_plane :
    local.control_plane_names[k] => {
      instance_id = tostring(vm.vm_id)
      ip          = local.cp_ips[k]
      provider    = "proxmox"
    }
  }
}

output "pool_id" {
  description = "Proxmox resource pool the control-plane VMs join, or null when they join none."
  value       = var.pool_id
}

output "cloud_init_upload_mode" {
  description = "How cloud-init snippets are copied to the Proxmox host for the control plane, or null for the provider default (stream)."
  value       = var.cloud_init_upload_mode
}
